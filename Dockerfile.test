# Legion install-requirements smoke test
# Tests Python imports for both Flask and Qt6 modes from a clean Kali base.
# Tool binary tests are skipped in Docker (they run on the full Kali install).
#
# Usage:
#   sudo docker build --no-cache -f Dockerfile.test -t legion-test .
#   sudo docker run --rm legion-test

FROM kalilinux/kali-rolling

ENV DEBIAN_FRONTEND=noninteractive
ENV QT_QPA_PLATFORM=offscreen

# ── Step 1: Update package index ───────────────────────────────────────────
RUN apt-get update -q

# ── Step 2: Install Python (required, must succeed) ────────────────────────
RUN apt-get install -y python3 python3-pip python3-dev git build-essential

# ── Step 3: Install shared libs for Qt6 offscreen + PyQt6 imports ──────────
RUN apt-get install -y --no-install-recommends \
    libgl1 libegl1 \
    libglib2.0-0 libdbus-1-3 libfontconfig1 libfreetype6 \
    libx11-6 libxext6 libxrender1 \
    libxcb1 libxkbcommon0 \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── Step 4: Copy repo ──────────────────────────────────────────────────────
WORKDIR /legion
COPY . .

# ── Step 5: Install Python requirements + pytest ───────────────────────────
RUN python3 -m pip install --break-system-packages -q -r requirements.txt
RUN python3 -m pip install --break-system-packages -q pytest

# ── Step 6: Run the test suite ─────────────────────────────────────────────
# Tool binary tests are skipped automatically (_in_docker() returns True).
# Package import tests and Flask/Qt6 startup tests run in full.
CMD ["python3", "-m", "pytest", "tests/test_requirements.py", \
     "--noconftest", "-v", "--tb=short", "-q"]
